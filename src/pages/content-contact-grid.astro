---
import Layout from '../layouts/Default.astro';
const title = 'Contact Grid'
---

<Layout title={title}>
  <div class="contact-grid-wrapper">
    <!--Toolbar-->
    <div class="toolbar is-spaced-bottom is-responsive">
      <div class="toolbar-start">
        <h2 class="title is-4 is-narrow">Contacts</h2>
      </div>
      <div class="toolbar-end">
        <div class="control hidden-item">
          <div class="select sorting-select">
            <select>
              <option value="5">Sort by</option>
              <option value="10">Latest</option>
              <option value="25">Oldest</option>
              <option value="50">Earnings</option>
              <option value="100">Company</option>
            </select>
          </div>
        </div>
        <div class="icon-links">
          <a href="/content-contact-list" class="icon-link">
            <i class="iconify" data-icon="feather:list"></i>
          </a>
          <a href="/content-contact-grid" class="icon-link is-active">
            <i class="iconify" data-icon="feather:grid"></i>
          </a>
        </div>
        <button class="button is-primary is-long-2 raised">
          <i class="iconify mr-2" data-icon="feather:plus"></i>
          <span>New Contact</span>
        </button>
      </div>
    </div>

    <!--Grid-->
    <div class="contact-grid">
      <div class="columns is-multiline b-columns-half-tablet-p">
        <!--Item-->
        <div class="column is-4">
          <div class="contact-grid-item">
            <div class="item-body">
              <div class="contact">
                <div class="avatar is-md">
                  <img src="/img/avatars/42.jpg" alt="user photo" />
                </div>
                <div class="meta">
                  <h4 class="title is-6 is-narrow">Helen Miller</h4>
                  <p>Software Engineer</p>
                  <a mailto="helenmiller@gmail.com">helenmiller@gmail.com</a>
                </div>
              </div>
              <span class="tag is-light is-info is-rounded is-uppercase"
                >Working</span
              >
            </div>
            <div class="item-footer">
              <div class="actions">
                <a class="action">
                  <i class="iconify" data-icon="feather:edit-2"></i>
                </a>
                <a class="action">
                  <i class="iconify" data-icon="feather:message-circle"></i>
                </a>
                <a class="action">
                  <i class="iconify" data-icon="feather:mail"></i>
                </a>
              </div>
              <div class="details">
                <a href="/content-contact" class="button is-primary is-outlined raised">Details</a>
              </div>
            </div>
          </div>

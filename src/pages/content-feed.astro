---
import Layout from '../layouts/Default.astro';
import CrmSegmentDropdown from '../components/CrmSegmentDropdown.astro';
const title = 'Feed'
---

<Layout title={title}>
  <div class="columns is-multiline">
    <!--Left-->
    <div class="column is-3 hidden-column">
      <div class="action-widget">
        <img src="/img/illustrations/sorcerer.svg" alt="Widget picture" />
        <div class="widget-content">
          <h3 class="title is-6 is-leading">Contribute</h3>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Qui non
            moveatur et offensione
          </p>
        </div>
        <div class="buttons is-centered">
          <a class="button is-primary is-fullwidth raised">Share Wisdom</a>
        </div>
      </div>
    </div>

    <!--Center-->
    <div class="column">
      <!--Compose-->
      <div class="compose-card">
        <div class="compose-toolbar">
          <div class="compose-avatar is-hidden-mobile">
            <img src="/img/avatars/55.jpg" alt="Your picture" />
          </div>
          <div class="actions">
            <a class="action text-primary">
              <iconify-icon class="iconify" icon="ph:bell-simple-duotone"></iconify-icon>
            </a>
            <a class="action text-danger">
              <iconify-icon class="iconify" icon="ph:heart-duotone"></iconify-icon>
            </a>
            <a class="action text-yellow">
              <iconify-icon class="iconify" icon="ph:smiley-duotone"></iconify-icon>
            </a>
            <a class="action text-success">
              <iconify-icon class="iconify" icon="ph:map-pin-duotone"></iconify-icon>
            </a>
          </div>
        </div>
        <div class="status-wrapper">
          <textarea
            class="textarea"
            rows="1"
            placeholder="Write something ..."
          ></textarea>
        </div>
      </div>

      <!-- Feed item-->
      <div class="post-item">
        <div class="post-header p-5">
          <div class="is-flex">
            <div class="avatar is-xs">
              <img src="/img/avatars/55.jpg" alt="Author photo" />
            </div>

            <div class="item-title">
              <span>Posted by <a href="#">Daniel Walsh</a></span>
              <span class="block feed-time-small">45 minutes ago</span>
            </div>
            <!--Dropdown-->
            <CrmSegmentDropdown />
          </div>
          <div class="post-title">
            <a href="#">Starting a new design system</a>
          </div>
          <p class="post-text">
            Lorem Ipsum is simply dummy text of the printing and typesetting
            industry Lorem Ipsum is simply dummy text Lorem Ipsum ...
          </p>
        </div>

        <div class="is-flex">
          <div class="feed-image-container">
            <img
              src="https://i.pinimg.com/originals/11/e5/f1/11e5f132eefe130f96492d69de226cf1.jpg"
              alt="Featured image"
            />
          </div>
        </div>
        <div class="is-flex p-5">
          <div class="feed-item-footer">
            <div class="counter-blocks">
              <div class="counter-block">
                <iconify-icon class="iconify rem-90 text-light" icon="ph:heart-duotone"></iconify-icon>
                <span class="rem-90">31</span>
              </div>
              <div class="counter-block">
                <iconify-icon class="iconify rem-90 text-light" icon="ph:chat-circle-duotone"></iconify-icon>
                <span class="rem-90">5</span>
              </div>
              <div class="counter-block">
                <iconify-icon class="iconify rem-90 text-light" icon="ph:paperclip-duotone"></iconify-icon>
                <span class="rem-90">1</span>
              </div>
            </div>
            <a class="arrow-link">
              <span>Read More</span>
              <iconify-icon class="iconify" icon="lucide:arrow-right"></iconify-icon>
            </a>
          </div>
        </div>
      </div>

      <!-- Feed item-->
      <div class="post-item">
        <div class="post-header p-5">
          <div class="is-flex">
            <div class="avatar is-xs">
              <img src="/img/avatars/42.jpg" alt="Author photo" />
            </div>

            <div class="item-title">
              <span>Posted by <a href="#">Helen Miller</a></span>
              <span class="block feed-time-small">3 hours ago</span>
            </div>
            <!--Dropdown-->
            <CrmSegmentDropdown />
          </div>
          <div class="post-title">
            <a href="#">How I built the company mobile UI kit</a>
          </div>
          <p class="post-text">
            Lorem Ipsum is simply dummy text of the printing and typesetting
            industry Lorem Ipsum is simply dummy text Lorem Ipsum ...
          </p>
        </div>

        <div class="is-flex">
          <div class="feed-image-container">
            <img
              src="https://i.pinimg.com/originals/df/f4/2b/dff42b0599900b13d21129e4f1fb531b.png"
              alt="Featured image"
            />
          </div>
        </div>
        <div class="is-flex p-5">
          <div class="feed-item-footer">
            <div class="counter-blocks">
              <div class="counter-block">
                <iconify-icon class="iconify rem-90 text-light" icon="ph:heart-duotone"></iconify-icon>
                <span class="rem-90">22</span>
              </div>
              <div class="counter-block">
                <iconify-icon class="iconify rem-90 text-light" icon="ph:chat-circle-duotone"></iconify-icon>
                <span class="rem-90">11</span>
              </div>
              <div class="counter-block">
                <iconify-icon class="iconify rem-90 text-light" icon="ph:paperclip-duotone"></iconify-icon>
                <span class="rem-90">4</span>
              </div>
            </div>
            <a class="arrow-link">
              <span>Read More</span>
              <iconify-icon class="iconify" icon="lucide:arrow-right"></iconify-icon>
            </a>
          </div>
        </div>
      </div>

      <!-- Feed item-->
      <div class="post-item">
        <div class="post-header p-5">
          <div class="is-flex">
            <div class="avatar is-xs">
              <img src="/img/avatars/29.jpg" alt="Author photo" />
            </div>

            <div class="item-title">
              <span>Posted by <a href="#">Christina Chu</a></span>
              <span class="block feed-time-small">8 hours ago</span>
            </div>
            <!--Dropdown-->
            <CrmSegmentDropdown />
          </div>
          <div class="post-title">
            <a href="#">Best practices for data analytics UI</a>
          </div>
          <p class="post-text">
            Lorem Ipsum is simply dummy text of the printing and typesetting
            industry Lorem Ipsum is simply dummy text Lorem Ipsum ...
          </p>
        </div>

        <div class="is-flex">
          <div class="feed-image-container">
            <img
              src="https://miro.medium.com/max/1400/1*favYtgNy7oA0YGY7mcYgDA.png"
              alt="Featured image"
            />
          </div>
        </div>
        <div class="is-flex p-5">
          <div class="feed-item-footer">
            <div class="counter-blocks">
              <div class="counter-block">
                <iconify-icon class="iconify rem-90 text-light" icon="ph:heart-duotone"></iconify-icon>
                <span class="rem-90">22</span>
              </div>
              <div class="counter-block">
                <iconify-icon class="iconify rem-90 text-light" icon="ph:chat-circle-duotone"></iconify-icon>
                <span class="rem-90">11</span>
              </div>
              <div class="counter-block">
                <iconify-icon class="iconify rem-90 text-light" icon="ph:paperclip-duotone"></iconify-icon>
                <span class="rem-90">4</span>
              </div>
            </div>
            <a class="arrow-link">
              <span>Read More</span>
              <iconify-icon class="iconify" icon="lucide:arrow-right"></iconify-icon>
            </a>
          </div>
        </div>
      </div>

      <div class="load-more-wrapper has-text-centered">
        <button
          class="button btn-dash is-fullwidth primary-btn raised ripple rounded no-lh"
        >
          Load more
        </button>
      </div>
    </div>

    <!--Right-->
    <div class="column is-4">
      <div class="list-widget mb-4">
        <div class="toolbar is-spaced-bottom">
          <div class="toolbar-start">
            <h4 class="title is-6">Users</h4>
          </div>
          <div class="toolbar-end"></div>
        </div>
        <ul class="inner-list">
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="avatar is-xs">
                  <img src="/img/avatars/6.jpg" alt="user photo" />
                </div>
                <div class="item-info">
                  <span class="item-title">Andrew Higgins</span>
                  <span>Software Engineer</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="avatar is-xs">
                  <img src="/img/avatars/44.jpg" alt="user photo" />
                </div>
                <div class="item-info">
                  <span class="item-title">Mary Spitz</span>
                  <span>Product Manager</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="avatar is-xs">
                  <img src="/img/avatars/34.jpg" alt="user photo" />
                </div>
                <div class="item-info">
                  <span class="item-title">Maggie Williams</span>
                  <span>Project Manager</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="avatar is-xs">
                  <img src="/img/avatars/32.jpg" alt="user photo" />
                </div>
                <div class="item-info">
                  <span class="item-title">Lana Belgard</span>
                  <span>Web Developer</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="avatar is-xs">
                  <img src="/img/avatars/33.jpg" alt="user photo" />
                </div>
                <div class="item-info">
                  <span class="item-title">Mike Delano</span>
                  <span>Backend Developer</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
        </ul>
      </div>

      <div class="list-widget">
        <div class="toolbar is-spaced-bottom">
          <div class="toolbar-start">
            <h4 class="title is-6">Topics</h4>
          </div>
          <div class="toolbar-end"></div>
        </div>
        <ul class="inner-list">
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="icon-box is-xs is-rounded is-primary">
                  <iconify-icon class="iconify" icon="ph:rocket-duotone"></iconify-icon>
                </div>
                <div class="item-info">
                  <span class="item-title">Startups</span>
                  <span>179 posts</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="icon-box is-xs is-rounded is-green">
                  <iconify-icon class="iconify" icon="ph:mouse-duotone"></iconify-icon>
                </div>
                <div class="item-info">
                  <span class="item-title">Equipment</span>
                  <span>110 posts</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="icon-box is-xs is-rounded is-info">
                  <iconify-icon class="iconify" icon="ph:lifebuoy-duotone"></iconify-icon>
                </div>
                <div class="item-info">
                  <span class="item-title">Support</span>
                  <span>148 posts</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="icon-box is-xs is-rounded is-yellow">
                  <iconify-icon class="iconify" icon="ph:crown-simple-duotone"></iconify-icon>
                </div>
                <div class="item-info">
                  <span class="item-title">Royalties</span>
                  <span>15 posts</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
          <li>
            <div class="widget-list-item">
              <div class="list-item-data">
                <div class="icon-box is-xs is-rounded is-primary">
                  <iconify-icon class="iconify" icon="ph:flask-duotone"></iconify-icon>
                </div>
                <div class="item-info">
                  <span class="item-title">Experiments</span>
                  <span>61 posts</span>
                </div>
                <div class="item-action">
                  <a class="button is-solid">View</a>
                </div>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

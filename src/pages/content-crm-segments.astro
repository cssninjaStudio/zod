---
import Layout from '../layouts/Default.astro';
import CrmSegmentDropdown from '../components/CrmSegmentDropdown.astro';
const title = 'Segments'
---

<Layout title={title}>
  <!-- Boards Grid -->
  <div class="boards-grid">
    <div class="columns is-multiline b-columns-half-tablet-p">
      <!-- Board item -->
      <div
        class="column is-one-quarter-fullhd is-one-third-widescreen is-one-third-desktop"
      >
        <div class="boards-grid-item">
          <div class="card-inner">
            <h3 class="board-title">Industry</h3>
            <div class="board-icon">
              <img src="/img/logo/companies/tesla.svg" alt="Company logo" />
            </div>
            <h4 class="board-summary">45 deals, in 6 companies</h4>
            <div class="board-meta">
              <label class="status-toggle">
                <input type="checkbox" />
                <span class="toggler">
                  <span class="off">
                    <iconify-icon class="iconify" icon="lucide:lock"></iconify-icon>
                  </span>
                  <span class="on">
                    <iconify-icon class="iconify" icon="lucide:check"></iconify-icon>
                  </span>
                </span>
              </label>
              <div class="board-assignees">
                <div class="avatars">
                  <div class="avatar is-xs">
                    <img src="/img/avatars/5.jpg" alt="user photo" />
                  </div>
                  <div class="avatar is-xs">
                    <img src="/img/avatars/21.jpg" alt="user photo" />
                  </div>
                  <div class="avatar is-xs">
                    <img src="/img/avatars/6.jpg" alt="user photo" />
                  </div>
                  <div class="avatar is-fake is-xs is-count">
                    <span>+2</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="card-foot">
            <div class="footer-block">
              <div>
                <span>3.4k</span>
                <span>won deals</span>
              </div>
            </div>
            <div class="footer-block">
              <div>
                <span>1.2k</span>
                <span>lost deals</span>
              </div>
            </div>
          </div>
          <!--Dropdown-->
          <CrmSegmentDropdown />
        </div>
      </div>
      <!-- Board item -->
      <div
        class="column is-one-quarter-fullhd is-one-third-widescreen is-one-third-desktop"
      >
        <div class="boards-grid-item">
          <div class="card-inner">
            <h3 class="board-title">Commerce</h3>
            <div class="board-icon">
              <img src="/img/logo/companies/amazon.svg" alt="Company logo" />
            </div>
            <h4 class="board-summary">78 deals, in 17 companies</h4>
            <div class="board-meta">

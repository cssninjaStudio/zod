---
import Layout from '../layouts/Default.astro';
const title = 'Ecommerce Dashboard'
---

<Layout title={title}>
  <div x-data="initCommerceDashboard()" x-init="initCustomBars()" class="ecommerce-dashboard">
    <!--Tiles-->
    <div class="dashboard-tiles">
      <div class="columns b-columns-half-tablet-p">
        <!--Dashboard tile-->
        <div class="column is-3">
          <div class="dashboard-tile">
            <div class="tile-content">
              <h4 class="tile-label">Sales</h4>
              <span class="tile-value">$9,854.76</span>
              <div class="tile-footer">
                <div class="icon-box is-success is-rounded">
                  <i class="iconify" data-icon="ph:coins-duotone"></i>
                </div>
                <div class="flex-meta">
                  <p class="paragraph rem-85">
                    <span class="text-success">+7.8%</span> this month
                  </p>
                </div>
              </div>
            </div>
            <div class="tile-bar">
              <div class="animated-bar is-success" data-percent="58"></div>
            </div>
          </div>
        </div>
        <!--Dashboard tile-->
        <div class="column is-3">
          <div class="dashboard-tile">
            <div class="tile-content">
              <h4 class="tile-label">Customers</h4>
              <span class="tile-value">5,276</span>
              <div class="tile-footer">
                <div class="icon-box is-yellow is-rounded">
                  <i class="iconify" data-icon="ph:users-three-duotone"></i>
                </div>
                <div class="flex-meta">
                  <p class="paragraph rem-85">
                    <span class="text-yellow">+2.3%</span> this month
                  </p>
                </div>
              </div>
            </div>
            <div class="tile-bar">
              <div class="animated-bar is-yellow" data-percent="90"></div>
            </div>
          </div>
        </div>
        <!--Dashboard tile-->
        <div class="column is-3">
          <div class="dashboard-tile">
            <div class="tile-content">
              <h4 class="tile-label">Taxes</h4>
              <span class="tile-value">$1,349</span>
              <div class="tile-footer">
                <div class="icon-box is-primary is-rounded">
                  <i class="iconify" data-icon="ph:crown-duotone"></i>
                </div>
                <div class="flex-meta">
                  <p class="paragraph rem-85">
                    <span class="text-primary">+1.1%</span> this month
                  </p>
                </div>
              </div>
            </div>
            <div class="tile-bar">
              <div class="animated-bar is-primary" data-percent="22"></div>
            </div>
          </div>
        </div>
        <!--Dashboard tile-->
        <div class="column is-3">
          <div class="dashboard-tile">
            <div class="tile-content">
              <h4 class="tile-label">Income</h4>
              <span class="tile-value">$6,212</span>
              <div class="tile-footer">
                <div class="icon-box is-purple is-rounded">
                  <i class="iconify" data-icon="ph:trophy-duotone"></i>
                </div>
                <div class="flex-meta">
                  <p class="paragraph rem-85">
                    <span class="text-purple">+1.1%</span> this month
                  </p>
                </div>
              </div>
            </div>
            <div class="tile-bar">
              <div class="animated-bar is-purple" data-percent="75"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!--Charts-->
    <div class="dashboard-charts">
      <div class="columns">
        <!--Donut Chart-->
        <div class="column is-5">
          <div class="dashboard-chart">
            <h3 class="title is-6">Channels</h3>
            <div id="eCommerceDonutChart"></div>
            <div class="chart-footer">
              <div class="icon-box is-orange is-rounded">
                <i class="iconify" data-icon="ph:chart-pie-slice-duotone"></i>
              </div>
              <div class="flex-meta">
                <p class="paragraph rem-80">
                  Learn more about your sales by opening the custom reports tab.
                </p>
              </div>
              <div class="flex-end">
                <a class="button is-solid">Learn More</a>
              </div>
            </div>
          </div>
        </div>
        <!--Line Chart-->
        <div class="column is-7">
          <div class="dashboard-chart">
            <h3 class="title is-6">Income</h3>
            <div id="eCommerceLineChart"></div>
          </div>
        </div>
      </div>
    </div>

    <!--Table-->
    <div class="dashboard-table">

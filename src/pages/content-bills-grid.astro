---
import Layout from '../layouts/Default.astro';
const title = 'Bills Grid'
---

<Layout title={title}>
  <div class="bills-grid-wrapper">
    <!--Toolbar-->
    <div class="toolbar is-spaced-bottom is-responsive">
      <div class="toolbar-start">
        <h2 class="title is-4 is-narrow">Bills</h2>
      </div>
      <div class="toolbar-end">
        <div class="control hidden-item">
          <div class="select sorting-select">
            <select>
              <option value="5">Sort by</option>
              <option value="10">Latest</option>
              <option value="25">Oldest</option>
              <option value="50">Amount</option>
              <option value="100">Company</option>
            </select>
          </div>
        </div>
        <div class="icon-links">
          <a href="/content-bills-list" class="icon-link">
            <i class="iconify" data-icon="feather:list"></i>
          </a>
          <a href="/content-bills-grid" class="icon-link is-active">
            <i class="iconify" data-icon="feather:grid"></i>
          </a>
        </div>
        <button class="button is-primary is-long-2 raised">
          <i class="iconify mr-2" data-icon="feather:plus"></i>
          <span>New Bill</span>
        </button>
      </div>
    </div>

    <!--Grid-->
    <div class="bills-grid">
      <div class="columns is-multiline b-columns-half-tablet-p">
        <!--Item-->
        <div class="column is-4">
          <div class="bills-grid-item">
            <div class="item-body">
              <div class="company">
                <div class="company-logo">
                  <img src="/img/logo/companies/airbnb.svg" alt="company logo" />
                </div>
                <div class="meta">
                  <h4 class="title is-6 is-narrow">#B-15654</h4>
                  <p>Updated 2d ago</p>
                </div>
              </div>
              <div class="amount">
                <span>1228.21</span>
                <span class="tag is-light is-info is-rounded is-uppercase"
                  >Approved</span
                >
              </div>
            </div>
            <div class="item-footer">
              <div class="users">
                <div class="avatars is-loose">
                  <div class="avatar is-xxs">
                    <img src="/img/avatars/5.jpg" alt="user photo" />
                  </div>
                  <div class="avatar is-xxs">
                    <img src="/img/avatars/21.jpg" alt="user photo" />
                  </div>
                  <div class="avatar is-fake is-xxs is-count">
                    <span>+2</span>
                  </div>
                </div>
              </div>
              <div class="button-combo">
                <button class="button is-solid">View</button>
                <button class="button is-solid">Edit</button>
              </div>
            </div>
          </div>
        </div>
        <!--Item-->
        <div class="column is-4">
          <div class="bills-grid-item">
            <div class="item-body">
              <div class="company">
                <div class="company-logo">
                  <img
                    src="/img/logo/companies/atlassian.svg"

---
import Layout from '../layouts/Default.astro';
import ForumChannelDropdown from '../components/ForumChannelDropdown.astro';
import ForumTopicDropdown from '../components/ForumTopicDropdown.astro';
const title = 'Forum Channel'
---

<Layout title={title}>
  <!--Toolbar-->
  <div class="toolbar is-spaced-bottom">
    <div class="toolbar-start">
      <h2 class="title is-4 is-narrow">Annoucements</h2>
    </div>
    <div class="toolbar-end">
      <button class="button is-primary is-long-2 raised">
        <iconify-icon class="iconify mr-1" icon="lucide:plus"></iconify-icon>
        <span>New Topic</span>
      </button>
    </div>
  </div>

  <!-- Forum -->
  <div class="forum-wrap">
    <div class="forum-container">
      <!-- Heading -->
      <div class="channel-heading">
        <h3>49 Topics</h3>
        <ForumChannelDropdown />
      </div>

      <!-- Forum Moderators -->
      <div class="channel-moderators">
        <div class="avatars">
          <div class="avatar is-sm">
            <img src="/img/avatars/42.jpg" alt="user photo" />
          </div>
          <div class="avatar is-sm">
            <img src="/img/avatars/29.jpg" alt="user photo" />
          </div>
          <div class="avatar is-sm">
            <img src="/img/avatars/21.jpg" alt="user photo" />
          </div>
        </div>
        <div class="moderators-meta">
          <span><a>Elie</a>, <a>Helen</a> and <a>Henry</a></span>
          <span>are moderating this channel</span>
        </div>
      </div>
      <!-- Topic list -->
      <div class="topic-list">
        <!-- Topic -->
        <div class="topic-card is-sticky">
          <div class="topic-owner">
            <div class="avatar is-sm">
              <img src="/img/avatars/33.jpg" alt="user photo" />
            </div>
          </div>
          <div class="topic-meta">
            <a href="/content-forum-topic" class="topic-title">
              Sticky: Important note about future partnerships
            </a>
            <div class="flex-block">
              <span>
                <span>2 hours ago, by</span>
                <a>Tom Wilson</a>
              </span>
            </div>
          </div>
          <div class="topic-actions">
            <iconify-icon class="iconify" icon="ph:envelope-duotone"></iconify-icon>
            <div class="topic-replies">
              <span>Replies</span>
              <span>9</span>
            </div>
            <div class="last-reply">
              <img src="/img/avatars/42.jpg" alt="user photo" />
              <div class="last-reply-meta">
                <span>Last reply</span>
                <span>2 minutes ago</span>
              </div>
            </div>
            <!-- Dropdown -->
            <ForumTopicDropdown />
          </div>
        </div>
        <!-- Topic -->
        <div class="topic-card is-sticky">
          <div class="topic-owner">
            <div class="avatar is-sm">
              <img src="/img/avatars/21.jpg" alt="user photo" />
            </div>
          </div>
          <div class="topic-meta">
            <a href="/content-forum-topic" class="topic-title"
              >Sticky: Don't post team updates here anymore</a
            >
            <div class="flex-block">
              <span>2 hours ago, by <a>Linda Gheller</a></span>
            </div>
          </div>
          <div class="topic-actions">
            <iconify-icon class="iconify" icon="ph:envelope-duotone"></iconify-icon>
            <div class="topic-replies">
              <span>Replies</span>
              <span>9</span>
            </div>
            <div class="last-reply">
              <img src="/img/avatars/19.jpg" alt="user photo" />
              <div class="last-reply-meta">
                <span>Last reply</span>
                <span>2 hours ago</span>

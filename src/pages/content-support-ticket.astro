---
import Layout from '../layouts/Default.astro';
import SupportTicketDropdown from '../components/SupportTicketDropdown.astro';
const title = 'Ticket Details'
---

<Layout title={title}>
  <div class="single-ticket-wrapper" x-data="initSupportTicket()">
    <!--Toolbar-->
    <div class="toolbar is-spaced-bottom is-responsive">
      <div class="toolbar-start">
        <h2 class="title is-4 is-narrow">Conversation #48615</h2>
      </div>
      <div class="toolbar-end">
        <div class="under-links">
          <a href="#" class="under-link">
            <i class="iconify" data-icon="feather:phone"></i>
            <span>Help</span>
          </a>
          <a href="#" class="under-link">
            <i class="iconify" data-icon="feather:printer"></i>
            <span>Print</span>
          </a>
          <a href="#" class="under-link">
            <i class="iconify" data-icon="feather:flag"></i>
            <span>Report</span>
          </a>
        </div>
      </div>
    </div>

    <div class="columns">
      <div class="column is-7">
        <!-- Single ticket -->
        <div class="ticket-wrapper">
          <!-- Header -->
          <div class="ticket-header">
            <div class="header-content">
              <div class="ticket-heading">
                <h2>Misdelivery of items not specified in order</h2>
                <span>Ticket #48615 - created April 4, 2022</span>
              </div>
            </div>
          </div>
          <!-- Body -->
          <div class="ticket-body">
            <div class="conversation-wrap">
              <div class="conversation-inner">
                <img src="/img/avatars/5.jpg" alt="user photo" />
                <div class="conversation-box">
                  <div class="content">
                    <p>Hi,</p>
                    <p>
                      It seems i have been delivered items that i have not
                      ordered.
                    </p>
                    <p>Can you please check the order again ?</p>
                    <p>Thanks a lot.</p>
                    <p>Christina</p>
                  </div>
                </div>
              </div>
              <div class="controls">
                <span class="timestamp">April 4 2022, 09:41am</span>
                <div class="button-group">
                  <a class="conversation-control">
                    <i class="sl icon-lock"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-envelope-open"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-flag"></i>
                  </a>
                </div>
              </div>
            </div>
            <div class="conversation-wrap">
              <div class="conversation-inner">
                <img src="/img/avatars/25.jpg" alt="user photo" />
                <div class="conversation-box">
                  <div class="content">
                    <p>Hello Alex,</p>
                    <p>
                      Of course, we would be happy to help you solve this issue.
                    </p>
                    <p>
                      Iam going to double check with the order chain to see what
                      went wrong.
                    </p>
                    <p>
                      Can you please also confirm that the items you ordered were
                      delivered too?
                    </p>
                    <p>Thank you very much.</p>
                    <p>Anthony Miller, customer support.</p>
                  </div>
                </div>
              </div>
              <div class="controls">
                <span class="timestamp">April 4 2022, 02:23pm</span>
                <div class="button-group">
                  <a class="conversation-control">
                    <i class="sl icon-pencil"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-envelope-open"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-flag"></i>
                  </a>
                </div>
              </div>
            </div>
            <div class="conversation-wrap">
              <div class="conversation-inner">
                <img src="/img/avatars/5.jpg" alt="user photo" />
                <div class="conversation-box">
                  <div class="content">
                    <p>Yes,</p>
                    <p>
                      I can confirm that the items i ordered were included in the
                      delivery.
                    </p>
                    <p>
                      Do you need additional details about the misdelivered items
                      ?
                    </p>
                  </div>
                </div>
              </div>
              <div class="controls">
                <span class="timestamp">April 4 2022, 03:56pm</span>
                <div class="button-group">
                  <a class="conversation-control">
                    <i class="sl icon-lock"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-envelope-open"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-flag"></i>
                  </a>
                </div>
              </div>
            </div>
            <div class="conversation-wrap">
              <div class="conversation-inner">
                <img src="/img/avatars/25.jpg" alt="user photo" />
                <div class="conversation-box">
                  <div class="content">
                    <p>Perfect,</p>
                    <p>
                      Don't bother for products info, we identified the items that
                      were misdelivered to you.
                    </p>
                    <p>
                      One of our agents will come by your place and get the
                      misdelivered products from you. Please excuse us for the
                      trouble and again, thank you very much.
                    </p>
                    <p>Anthony Miller, customer support.</p>
                  </div>
                </div>
              </div>
              <div class="controls">
                <span class="timestamp">April 4 2022, 04:19pm</span>
                <div class="button-group">
                  <a class="conversation-control">
                    <i class="sl icon-pencil"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-envelope-open"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-flag"></i>
                  </a>
                </div>
              </div>
            </div>
            <div class="conversation-wrap">
              <div class="conversation-inner">
                <img src="/img/avatars/5.jpg" alt="user photo" />
                <div class="conversation-box">
                  <div class="content">
                    <p>Great,</p>
                    <p>I'll wait then.</p>
                    <p>Thanks for the fast response.</p>
                  </div>
                </div>
              </div>
              <div class="controls">
                <span class="timestamp">April 4 2022, 06:51</span>
                <div class="button-group">
                  <a class="conversation-control">
                    <i class="sl icon-lock"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-envelope-open"></i>
                  </a>
                  <a class="conversation-control">
                    <i class="sl icon-flag"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
          <!-- Compose message -->
          <div x-ref="composemessage" class="compose-message">
            <img src="/img/avatars/25.jpg" alt="user photo" />
            <div class="control">
              <textarea
                x-on:input="typeReply($event)"
                id="compose-reply"
                class="textarea"
                rows="1"
                placeholder="Write a message..."
              ></textarea>
              <button class="button send-button">
                <i class="iconify" data-icon="fluent:send-24-filled"></i>
              </button>
            </div>
          </div>
          <!-- Attachments -->
          <div class="add-attachments small-uploader">
            <div class="upload">
              <input id="upload-attachments" type="file" accept="image/*" />
              <img
                class="main-preview"
                src="https://via.placeholder.com/150x150"
                alt=""
              />
              <i class="iconify" data-icon="feather:plus"></i>
              <span>Add Attachment</span>
            </div>

            <div class="uploader-previews"></div>
          </div>
        </div>
      </div>

      <!--Ticket info-->
      <div class="column is-4 is-offset-1">
        <div class="ticket-info">
          <div class="ticket-info-card">
            <div class="info-card-section is-dashed">
              <!--User-->
              <div class="user-details">
                <div class="avatar is-sm">
                  <img src="/img/avatars/5.jpg" alt="User photo" />
                </div>
                <div class="flex-meta">
                  <h3 class="title is-6 is-narrow">Christina Chu</h3>
                  <p class="rem-80">Opened 2 days ago</p>
                </div>
                <div class="flex-end">
                  <SupportTicketDropdown />
                </div>
              </div>
            </div>
            <div class="info-card-section is-dashed">
              <h4 class="section-heading">Information</h4>

              <ul class="inner-list">
                <li>
                  <div class="widget-list-item">
                    <div class="list-item-data">
                      <div class="icon-box is-primary is-small">
                        <i class="iconify" data-icon="feather:credit-card"></i>
                      </div>
                      <div class="item-info">
                        <span class="item-title">Purchase ID</span>
                        <span>c33bd77b-8681-46ba-aa52</span>
                      </div>
                      <div class="item-action">
                        <a class="text-light">
                          <i class="iconify" data-icon="feather:arrow-right"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="widget-list-item">
                    <div class="list-item-data">
                      <div class="icon-box is-success is-small">
                        <i class="iconify" data-icon="feather:clock"></i>
                      </div>
                      <div class="item-info">
                        <span class="item-title">Priority</span>
                        <span>Normal</span>
                      </div>
                      <div class="item-action">
                        <a class="text-light">
                          <i class="iconify" data-icon="feather:arrow-right"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="widget-list-item">
                    <div class="list-item-data">
                      <div class="icon-box is-info is-small">
                        <i class="iconify" data-icon="feather:mail"></i>
                      </div>
                      <div class="item-info">
                        <span class="item-title">Email</span>
                        <span>cchu@gmail.com</span>
                      </div>
                      <div class="item-action">
                        <a class="text-light">
                          <i class="iconify" data-icon="feather:arrow-right"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
              </ul>
            </div>
            <div class="info-card-section is-dashed">
              <h4 class="section-heading">Supported by</h4>

              <ul class="inner-list">
                <li>
                  <div class="widget-list-item">
                    <div class="list-item-data">
                      <div class="avatar is-xxs">
                        <img src="/img/avatars/25.jpg" alt="user photo" />
                      </div>
                      <div class="item-info">
                        <span class="item-title">Anthony Miller</span>
                        <span>Level 1</span>
                      </div>
                      <div class="item-action">
                        <a class="text-light">
                          <i class="iconify" data-icon="feather:arrow-right"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="widget-list-item">
                    <div class="list-item-data">
                      <div class="avatar is-xxs">
                        <img src="/img/avatars/52.jpg" alt="user photo" />
                      </div>
                      <div class="item-info">
                        <span class="item-title">Aya Banks</span>
                        <span>Level 2</span>
                      </div>
                      <div class="item-action">
                        <a class="text-light">
                          <i class="iconify" data-icon="feather:arrow-right"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
                <li>
                  <div class="widget-list-item">
                    <div class="list-item-data">
                      <div class="avatar is-xxs">
                        <img src="/img/avatars/19.jpg" alt="user photo" />
                      </div>
                      <div class="item-info">
                        <span class="item-title">Josh Stevens</span>
                        <span>Level 3</span>
                      </div>
                      <div class="item-action">
                        <a class="text-light">
                          <i class="iconify" data-icon="feather:arrow-right"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
              </ul>
            </div>
            <div class="info-card-section">
              <div class="buttons is-centered">
                <a class="button is-primary raised">Resolve</a>
                <a class="button is-solid">Edit</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
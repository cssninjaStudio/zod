---
import Layout from '../layouts/Default.astro';
import ForumCategoryDropdown from '../components/ForumCategoryDropdown.astro';
const title = 'Forum Home'
---

<Layout title={title}>
  <!--Toolbar-->
  <div class="toolbar is-spaced-bottom">
    <div class="toolbar-start">
      <h2 class="title is-4 is-narrow">Forum</h2>
    </div>
    <div class="toolbar-end">
      <button class="button is-primary is-long-2 raised">
        <i class="iconify mr-1" data-icon="feather:plus"></i>
        <span>New Topic</span>
      </button>
    </div>
  </div>

  <!-- Forum -->
  <div class="forum-wrap">
    <div class="forum-container">
      <!-- Heading -->
      <div class="channel-heading">
        <h3>Annoucements</h3>
        <ForumCategoryDropdown />
      </div>

      <!-- Channel -->
      <a href="/content-forum-channel" class="forum-channel">
        <div class="channel-icon">
          <i class="iconify" data-icon="ph:globe-hemisphere-west-duotone"></i>
          <div class="new-indicator">
            <span>3</span>
          </div>
        </div>
        <div class="channel-meta">
          <span>Company Annoucements</span>
          <span>Dedicated channel for company annoucements and heads up.</span>
        </div>
        <div class="channel-topics">
          <span>Topics</span>
          <span>49</span>
        </div>
        <div class="top-contributors">
          <div class="avatars">
            <div class="avatar is-xs">
              <img src="/img/avatars/42.jpg" alt="user photo" />
            </div>
            <div class="avatar is-xs">
              <img src="/img/avatars/29.jpg" alt="user photo" />
            </div>
            <div class="avatar is-xs">
              <img src="/img/avatars/21.jpg" alt="user photo" />
            </div>
            <div class="avatar is-fake is-xs is-count">
              <span>+2</span>
            </div>
          </div>
        </div>
      </a>
      <!-- Channel -->
      <a href="/content-forum-channel" class="forum-channel">
        <div class="channel-icon">
          <i class="iconify" data-icon="ph:users-three-duotone"></i>
        </div>
        <div class="channel-meta">
          <span>Team Annoucements</span>
          <span>Dedicated channel for team annoucements.</span>
        </div>
        <div class="channel-topics">
          <span>Topics</span>
          <span>12</span>
        </div>
        <div class="top-contributors">
          <div class="avatars">
            <div class="avatar is-xs">
              <img src="/img/avatars/19.jpg" alt="user photo" />
            </div>
            <div class="avatar is-xs">
              <img src="/img/avatars/55.jpg" alt="user photo" />
            </div>
            <div class="avatar is-xs">
              <img src="/img/avatars/6.jpg" alt="user photo" />
            </div>
            <div class="avatar is-fake is-xs is-count">
              <span>+6</span>
            </div>
          </div>
        </div>
      </a>
      <!-- Channel -->
      <a href="/content-forum-channel" class="forum-channel">

---
import Layout from '../layouts/Default.astro';
const title = 'Project List'
---

<Layout title={title}>
  <div class="project-list-wrapper">
    <!--Toolbar-->
    <div class="toolbar is-spaced-bottom is-responsive">
      <div class="toolbar-start">
        <h2 class="title is-4 is-narrow">Projects</h2>
      </div>
      <div class="toolbar-end">
        <div class="control hidden-item">
          <div class="select sorting-select">
            <select>
              <option value="5">Sort by</option>
              <option value="10">Latest</option>
              <option value="25">Oldest</option>
              <option value="50">Budget</option>
              <option value="100">Company</option>
            </select>
          </div>
        </div>
        <div class="icon-links">
          <a href="/content-project-list" class="icon-link is-active">
            <iconify-icon class="iconify" icon="lucide:list"></iconify-icon>
          </a>
          <a href="/content-project-grid" class="icon-link">
            <iconify-icon class="iconify" icon="lucide:grid"></iconify-icon>
          </a>
        </div>
        <button class="button is-primary is-primary is-long-2 raised">
          <iconify-icon class="iconify mr-2" icon="lucide:plus"></iconify-icon>
          <span>New Project</span>
        </button>
      </div>
    </div>

    <!--List-->
    <div class="project-list">
      <!--Item-->
      <div class="project-list-item">
        <div class="project">
          <div class="project-image">
            <img
              src="https://cdn.dribbble.com/users/427857/screenshots/16595968/media/b6063f2a28e40c075df23db13ace98df.png?compress=1&resize=400x300&vertical=top"
              alt="Project image"
            />
          </div>
          <div class="meta">
            <h4 class="title is-6 is-narrow">Project management app</h4>
            <p>Airbnb | Updated 2d ago</p>
          </div>
        </div>

        <div class="details">
          <div class="amount">
            <span>Budget</span>
            <span>~ 42.3K</span>
          </div>
          <div class="status">
            <span class="tag is-light is-info is-rounded is-uppercase"
              >Approved</span
            >
          </div>
          <div class="users">
            <div class="avatars is-loose">
              <div class="avatar is-xxs">
                <img src="/img/avatars/5.jpg" alt="user photo" />
              </div>
              <div class="avatar is-xxs">
                <img src="/img/avatars/21.jpg" alt="user photo" />
              </div>
              <div class="avatar is-xxs">
                <img src="/img/avatars/6.jpg" alt="user photo" />
              </div>
              <div class="avatar is-fake is-xxs is-count">
                <span>+2</span>
              </div>
            </div>
          </div>
          <div class="button-combo">
            <a href="/content-project" class="button is-solid">View</a>
            <button class="button is-solid">Edit</button>
          </div>
        </div>
      </div>
      <!--Item-->
      <div class="project-list-item">
        <div class="project">
          <div class="project-image">
            <img
              src="https://cdn.dribbble.com/users/3676159/screenshots/14603301/media/9790a0dd56bdbd8e97c3bd1bf362b3c6.png?compress=1&resize=400x300&vertical=top"
              alt="Project image"
            />
          </div>
          <div class="meta">
            <h4 class="title is-6 is-narrow">UX design app</h4>
            <p>Atlassian | Updated 3d ago</p>
          </div>
        </div>

        <div class="details">
          <div class="amount">
            <span>Budget</span>
            <span>~ 26.9K</span>
          </div>
          <div class="status">
            <span class="tag is-light is-warning is-rounded is-uppercase"
              >Overdue</span
            >
          </div>
          <div class="users">
            <div class="avatars is-loose">
              <div class="avatar is-xxs">
                <img src="/img/avatars/16.jpg" alt="user photo" />
              </div>
              <div class="avatar is-xxs">
                <img src="/img/avatars/52.jpg" alt="user photo" />
              </div>
            </div>
          </div>
          <div class="button-combo">
            <a href="/content-project" class="button is-solid">View</a>
            <button class="button is-solid">Edit</button>
          </div>
        </div>
      </div>
      <!--Item-->
      <div class="project-list-item">
        <div class="project">
          <div class="project-image">
            <img
              src="https://cdn.dribbble.com/users/4335179/screenshots/16094644/media/292727933a7d9413aa1232dac2d44624.png?compress=1&resize=400x300"
              alt="Project image"
            />
          </div>
          <div class="meta">
            <h4 class="title is-6 is-narrow">Music player app</h4>
            <p>Uber | Updated 3d ago</p>
          </div>
        </div>

        <div class="details">
          <div class="amount">
            <span>Budget</span>
            <span>~ 14.8K</span>
          </div>
          <div class="status">
            <span class="tag is-light is-info is-rounded is-uppercase"
              >New</span
            >
          </div>
          <div class="users">
            <div class="avatars is-loose">
              <div class="avatar is-xxs">
                <img src="/img/avatars/25.jpg" alt="user photo" />
              </div>
              <div class="avatar is-xxs">
                <img src="/img/avatars/17.jpg" alt="user photo" />
              </div>
              <div class="avatar is-xxs">
                <img src="/img/avatars/19.jpg" alt="user photo" />
              </div>
            </div>
          </div>
          <div class="button-combo">
            <a href="/content-project" class="button is-solid">View</a>
            <button class="button is-solid">Edit</button>
          </div>
        </div>
      </div>
      <!--Item-->
      <div class="project-list-item">
        <div class="project">
          <div class="project-image">
            <img
              src="https://cdn.dribbble.com/users/542812/screenshots/9977120/media/9d0ec1190ecb63408b842dda6608d425.png?compress=1&resize=400x300&vertical=top"
              alt="Project image"
            />
          </div>
          <div class="meta">
            <h4 class="title is-6 is-narrow">React JS design system</h4>
            <p>Airbnb | Updated 5d ago</p>
          </div>
        </div>

        <div class="details">
          <div class="amount">
            <span>Budget</span>
            <span>~ 12.5K</span>
          </div>
          <div class="status">
            <span class="tag is-light is-success is-rounded is-uppercase"
              >Approved</span
            >
          </div>
          <div class="users">
            <div class="avatars is-loose">
              <div class="avatar is-xxs">
                <img src="/img/avatars/14.jpg" alt="user photo" />
              </div>
              <div class="avatar is-xxs">
                <img src="/img/avatars/42.jpg" alt="user photo" />
              </div>
              <div class="avatar is-xxs">
                <img src="/img/avatars/52.jpg" alt="user photo" />
              </div>
              <div class="avatar is-fake is-xxs is-count">
                <span>+2</span>
              </div>
            </div>
          </div>
          <div class="button-combo">
            <a href="/content-project" class="button is-solid">View</a>
            <button class="button is-solid">Edit</button>
          </div>
        </div>
      </div>
      <!--Item-->
      <div class="project-list-item">
        <div class="project">
          <div class="project-image">
            <img
              src="https://cdn.dribbble.com/users/883236/screenshots/13490213/media/fb10ed4e43eb7d5064072d1bd2304975.png?compress=1&resize=400x300&vertical=top"
              alt="Project image"
            />
          </div>
          <div class="meta">
            <h4 class="title is-6 is-narrow">Company brand book</h4>
            <p>Heartman | Updated a week ago</p>
          </div>
        </div>

        <div class="details">
          <div class="amount">
            <span>Budget</span>
            <span>~ 7.8K</span>
          </div>
          <div class="status">
            <span class="tag is-light is-info is-rounded is-uppercase"
              >New</span
            >
          </div>
          <div class="users">
            <div class="avatars is-loose">
              <div class="avatar is-xxs">
                <img src="/img/avatars/35.jpg" alt="user photo" />
              </div>
              <div class="avatar is-xxs">
                <img src="/img/avatars/33.jpg" alt="user photo" />
              </div>
              <div class="avatar is-xxs">
                <img src="/img/avatars/56.jpg" alt="user photo" />
              </div>
            </div>
          </div>
          <div class="button-combo">
            <a href="/content-project" class="button is-solid">View</a>
            <button class="button is-solid">Edit</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
---
import Layout from '../layouts/Default.astro'
import ProjectTaskGroupDropdown from '../components/ProjectTaskGroupDropdown.astro'
import ProjectTaskDropdown from '../components/ProjectTaskDropdown.astro'
import ProjectFileDropdown from '../components/ProjectFileDropdown.astro'
import ProjectActivityDropdown from '../components/ProjectActivityDropdown.astro'
const title = 'Project Details'
---

<Layout title={title}>
  <div class="projects-wrapper" x-data="initProjectDetails()">
    <!--Header-->
    <div class="project-header-wrap">
      <div class="title-wrap">
        <h2 class="project-title">Personal Banking App</h2>
        <h4 class="project-tagline">Finishing Code related tasks and Launching the Marketing Campaign.</h4>
      </div>
      <div class="task-count">
        <iconify-icon class="iconify" icon="ph:timer-duotone"></iconify-icon>
        <span>38/42</span>
      </div>
      <div class="project-members-avatars">
        <div class="avatars">
          <div class="avatar">
            <img src="/img/avatars/17.jpg" alt="user photo" />
          </div>
          <div class="avatar">
            <img src="/img/avatars/42.jpg" alt="user photo" />
          </div>
          <div class="avatar">
            <img src="/img/avatars/55.jpg" alt="user photo" />
          </div>
          <div class="avatar is-fake is-count">
            <span>+4</span>
          </div>
        </div>
      </div>
    </div>

    <!--Tabs-->
    <div class="navigation-tabs animated-tabs">
      <div class="tabs">
        <ul>
          <li class="tab-link" @click="toggleTabs('tasks-tab')" :class=`{
              'is-active': activeTab === 'tasks-tab',
              '': activeTab !== 'tasks-tab',
            }`>
            <a>Tasks</a>
          </li>
          <li class="tab-link" @click="toggleTabs('files-tab')" :class=`{
              'is-active': activeTab === 'files-tab',
              '': activeTab !== 'files-tab',
            }`>
            <a>Files</a>
          </li>
          <li class="tab-link" @click="toggleTabs('activity-tab')" :class=`{
              'is-active': activeTab === 'activity-tab',
              '': activeTab !== 'activity-tab',
            }`>
            <a>Activity</a>
          </li>
        </ul>
      </div>
      <div x-show.transition="activeTab === 'tasks-tab'" class="navtab-content is-active">
        <!-- Task Group -->
        <div class="projects-list-wrapper">
          <!--Header-->
          <div class="list-header">
            <div class="list-title">
              <span>Tasks</span>
              <div class="add-button">
                <iconify-icon class="iconify" icon="lucide:plus"></iconify-icon>
              </div>
            </div>
            <div class="list-filter">
              <div class="control has-icon">
                <input class="input" type="text" placeholder="Filter Projects" />
                <div class="form-icon">
                  <iconify-icon class="iconify" icon="lucide:search"></iconify-icon>
                </div>
              </div>
            </div>
          </div>
          <div class="list-body">
            <div class="columns is-multiline">
              <div class="column">
                <!-- Task group -->
                <div class="tasks-wrapper">
                  <div class="header">
                    <h4 class="no-margin-bottom">Reviews <small>(3)</small></h4>

                    <!-- Dropdown -->
                    <ProjectTaskGroupDropdown />
                  </div>

                  <!-- Task Card -->
                  <div class="task-card">
                    <div class="card-progress" data-progress="83"></div>
                    <div class="card-inner">
                      <div class="task-meta">
                        <span class="task-title"> Project documents review </span>
                        <span class="task-due-date"> 5 days remaining </span>
                      </div>
                      <div class="task-info">
                        <div class="task-progress">
                          <progress class="progress is-tiny is-primary" value="82" max="100"> 82% </progress>
                        </div>
                        <div class="task-members">
                          <div class="avatars">
                            <div class="avatar is-xs">
                              <img src="/img/avatars/55.jpg" alt="user photo" />

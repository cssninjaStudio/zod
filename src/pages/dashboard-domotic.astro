---
import Layout from '../layouts/Default.astro';
const title = 'Domotic Dashboard'
---

<Layout title={title}>
  <div x-data="initDomoticDashboard()" class="domotic-dashboard">
    <div class="columns">
      <div class="column is-8">
        <div class="main-card">
          <div class="toggle-boxes">
            <!--Box-->
            <div
              class="toggle-box"
              data-target="living"
              :class="{
                'is-active': activeBox === 'living'
              }"
              @click.prevent="toggleBox($event)"
            >
              <i class="iconify" data-icon="ph:armchair-duotone"></i>
              <h3 class="box-title">Living Room</h3>
              <p>4 devices on</p>
              <progress class="progress is-tiny is-success" value="60" max="100">
                60%
              </progress>
            </div>
            <!--Box-->
            <div class="toggle-box"
              data-target="kitchen"
              :class="{
                'is-active': activeBox === 'kitchen'
              }"
              @click.prevent="toggleBox($event)"
            >
              <i class="iconify" data-icon="ph:cooking-pot-duotone"></i>
              <h3 class="box-title">Kitchen</h3>
              <p>5 devices on</p>
              <progress class="progress is-tiny is-success" value="80" max="100">
                80%
              </progress>
            </div>
            <!--Box-->
            <div class="toggle-box"
              data-target="office"
              :class="{
                'is-active': activeBox === 'office'
              }"
              @click.prevent="toggleBox($event)"
            >
              <i class="iconify" data-icon="ph:lamp-duotone"></i>
              <h3 class="box-title">Office</h3>
              <p>2 devices on</p>
              <progress class="progress is-tiny is-success" value="30" max="100">
                30%
              </progress>
            </div>
            <!--Box-->
            <div class="toggle-box"
              data-target="bathroom"
              :class="{
                'is-active': activeBox === 'bathroom'
              }"
              @click.prevent="toggleBox($event)"
            >
              <i class="iconify" data-icon="ph:bathtub-duotone"></i>
              <h3 class="box-title">Bathroom</h3>
              <p>1 device on</p>
              <progress class="progress is-tiny is-success" value="10" max="100">
                10%
              </progress>
            </div>
          </div>

          <div class="vision-container">
            <!--Actions-->
            <div class="vision-actions">
              <button class="is-active">
                <i class="iconify" data-icon="ph:video-camera-duotone"></i>
              </button>
              <button>
                <i class="iconify" data-icon="ph:bell-simple-duotone"></i>
              </button>
              <button>
                <i class="iconify" data-icon="ion:plus-round"></i>
              </button>
            </div>
            <!--Images-->
            <img
              x-show="activeBox === 'living'"
              src="https://images.pexels.com/photos/1669799/pexels-photo-1669799.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940"
              alt="Vision"
            />
            <img
              x-show="activeBox === 'kitchen'"
              src="https://images.pexels.com/photos/3637739/pexels-photo-3637739.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940"
              alt="Vision"
            />
            <img
              x-show="activeBox === 'office'"
              src="https://images.pexels.com/photos/667838/pexels-photo-667838.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940"
              alt="Vision"
            />
            <img
              x-show="activeBox === 'bathroom'"
              src="https://images.pexels.com/photos/1571461/pexels-photo-1571461.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940"
              alt="Vision"
            />
          </div>
        </div>
      </div>
      <div class="column is-4">
        <div class="mb-4">
          <button class="button is-primary is-fullwidth is-big raised">
            <i class="iconify" data-icon="ion:plus-round"></i>
            <span class="ml-2">Add New Room</span>
          </button>
        </div>
        <!--Summary Card-->
        <div class="summary-card">
          <div class="summary-card-header">
            <h4 class="title is-6 is-narrow">Summary</h4>
            <p>11:30am</p>
          </div>
          <div class="summary-card-body">
            <div class="summary-stats">
              <i class="iconify" data-icon="teenyicons:home-solid"></i>
              <div class="stat-block">
                <span class="stat-label">Temperature</span>
                <span class="stat-value">23°</span>
              </div>
              <div class="stat-block">
                <span class="stat-label">Devices on</span>
                <span class="stat-value">9</span>
              </div>
            </div>
            <p class="card-text">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Expectoque
              quid ad id, quod.
            </p>
            <div class="progress-block">
              <div class="progress-text">
                <p>Condition</p>
                <p class="text-success">Good</p>
              </div>
              <progress class="progress is-small is-success" value="75" max="100">
                75%
              </progress>
            </div>
            <div class="alert is-warning">
              <p>Your electric power is unstable</p>
              <button class="alert-close">
                <i class="iconify" data-icon="feather:x"></i>
              </button>
            </div>
          </div>
        </div>
        <!--Status Cards-->
        <div class="status-cards">
          <!--Status Card-->
          <div class="status-card">
            <div class="meta">
              <h4 class="title is-6 is-narrow">Microwave</h4>
              <p>11:30am - 15 minutes</p>
            </div>
            <div class="action">
              <label class="f-switch is-success">
                <input type="checkbox" class="is-switch" checked />
                <i></i>
              </label>
            </div>
          </div>
          <!--Status Card-->
          <div class="status-card">
            <div class="meta">
              <h4 class="title is-6 is-narrow">Television</h4>
              <p>10:30am - 2 hours</p>
            </div>
            <div class="action">
              <label class="f-switch is-success">
                <input type="checkbox" class="is-switch" checked />
                <i></i>
              </label>
            </div>
          </div>
          <!--Status Card-->
          <div class="status-card">
            <div class="meta">
              <h4 class="title is-6 is-narrow">Lamps</h4>
              <p>Off for 4 hours</p>
            </div>
            <div class="action">
              <label class="f-switch is-success">
                <input type="checkbox" class="is-switch" />
                <i></i>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
---
import Layout from '../layouts/Default.astro';
const title = 'Apex Charts'
---

<Layout title={title}>
  <div class="demo-charts-wrapper" x-data="initApexCharts()">
    <div class="columns is-multiline">
      <!--Logo Card-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="chart-illustration">
            <img src="/img/illustrations/apex.svg" alt="Illustration" />
            <div class="chart-card-content">
              <h4 class="title is-6 is-narrow">Apex Charts</h4>
              <p class="rem-90">Javascript charting library</p>
            </div>
          </div>
        </div>
      </div>

      <!--Apex Area Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Area Chart</h3>
          </div>
          <div id="apexAreaChart"></div>
        </div>
      </div>

      <!--Apex Line Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Line Chart</h3>
          </div>
          <div id="apexLineChart"></div>
        </div>
      </div>

      <!--Apex Single Line Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Line Chart</h3>
          </div>
          <div id="apexSingleLineChart"></div>
        </div>
      </div>

      <!--Apex Step Line Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Step Line</h3>
          </div>
          <div id="apexStepLineChart"></div>
        </div>
      </div>

      <!--Apex Bar Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Bar Chart</h3>
          </div>
          <div id="apexBarChart"></div>
        </div>
      </div>

      <!--Apex Multiple Bar Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Multiple Bars</h3>
          </div>
          <div id="apexBarMultipleChart"></div>
        </div>
      </div>

      <!--Apex Stacked Bar Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Stacked Bars</h3>
          </div>
          <div id="apexBarStackedChart"></div>
        </div>
      </div>

      <!--Apex Column Bar Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Range Columns</h3>
          </div>
          <div id="apexBarColumnChart"></div>
        </div>
      </div>

      <!--Apex Horizontal Bar Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Horizontal Bar</h3>
          </div>
          <div id="apexBarHorizontalChart"></div>
        </div>
      </div>

      <!--Apex Horizontal Multiple Bar Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Horizontal Multiple</h3>
          </div>
          <div id="apexBarHorizontalMultipleChart"></div>
        </div>
      </div>

      <!--Apex Timeline Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Timeline Chart</h3>
          </div>
          <div id="apexTimelineChart"></div>
        </div>
      </div>

      <!--Apex Bubble Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Bubble Chart</h3>
          </div>
          <div id="apexBubbleChart"></div>
        </div>
      </div>

      <!--Apex Scatter Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Scatter Chart</h3>
          </div>
          <div id="apexScatterChart"></div>
        </div>
      </div>

      <!--Apex Pie Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Pie Chart</h3>
          </div>
          <div id="apexPieChart"></div>
        </div>
      </div>

      <!--Apex Donut Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Donut Chart</h3>
          </div>
          <div id="apexDonutChart"></div>
        </div>
      </div>

      <!--Apex Radial Chart-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Radial Chart</h3>
          </div>
          <div id="apexRadialChart"></div>
        </div>
      </div>

      <!--Apex Radial Multiple-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Radial Multiple</h3>
          </div>
          <div id="apexRadialMultipleChart"></div>
        </div>
      </div>

      <!--Apex Radial Gauge-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Radial Gauge</h3>
          </div>
          <div id="apexRadialGaugeChart"></div>
        </div>
      </div>

      <!--Apex Radar-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Radar Chart</h3>
          </div>
          <div id="apexRadarChart"></div>
        </div>
      </div>

      <!--Apex Gauge-->
      <div class="column is-4">
        <div class="chart-card">
          <div class="card-head p-4">
            <h3 class="title is-6">Gauge Chart</h3>
          </div>
          <div id="apexGaugeChart"></div>
        </div>
      </div>
    </div>
  </div>
</Layout>
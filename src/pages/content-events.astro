---
import Layout from '../layouts/Default.astro';
const title = 'Events'
---

<Layout title={title}>
  <div class="event-tiles">
    <div class="columns is-multiline">
      <!-- Event pill -->
      <div class="column is-3">
        <a class="event-tile">
          <div class="event-circle is-red"></div>
          <div class="event-category">
            <span>Corporate Events</span>
            <span>7 Events</span>
          </div>
        </a>
      </div>
      <!-- Event pill -->
      <div class="column is-3">
        <a class="event-tile">
          <div class="event-circle is-secondary"></div>
          <div class="event-category">
            <span>Tech Events</span>
            <span>13 Events</span>
          </div>
        </a>
      </div>
      <!-- Event pill -->
      <div class="column is-3">
        <a class="event-tile">
          <div class="event-circle is-green"></div>
          <div class="event-category">
            <span>Business Events</span>
            <span>3 Events</span>
          </div>
        </a>
      </div>
      <!-- Event pill -->
      <div class="column is-3">
        <a class="event-tile">
          <div class="event-circle is-orange"></div>
          <div class="event-category">
            <span>Team Events</span>
            <span>21 Events</span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div class="subevent-cards">
    <div class="columns is-multiline">
      <!-- Subevent card -->
      <div class="column is-3">
        <div class="subevent-card is-red">
          <!-- Front side -->
          <div class="front-face animated preFadeInUp fadeInUp">
            <div class="event-date">
              <div class="date-number">12</div>
              <div class="date-meta">
                <span>thursday</span>
                <span>october 2022</span>
              </div>
            </div>
            <!-- Title -->
            <div class="event-title">
              <span>Startup Meetup</span>
              <span>Starts at 06:30PM</span>
            </div>
            <!-- Participants -->
            <div class="event-participants">
              <div class="avatars is-loose">
                <div class="avatar is-xxs">
                  <img src="/img/avatars/42.jpg" alt="user photo" />
                </div>
                <div class="avatar is-xxs">
                  <img src="/img/avatars/29.jpg" alt="user photo" />
                </div>
                <div class="avatar is-xxs">
                  <img src="/img/avatars/55.jpg" alt="user photo" />
                </div>
                <div class="avatar is-fake is-xxs is-count">
                  <span>+6</span>
                </div>
              </div>
            </div>
          </div>
          <!-- Back side -->
          <div class="back-face animated preFadeInUp fadeInUp">
            <div class="back-inner">
              <div class="event-summary">
                <span>Event Summary</span>
                <p>
                  Lorem ipsum dolor sit amet, ad blandit intellegam cum, nulla
                  legere possit id vim, clita nullam graecis duo ne.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Subevent card -->
      <div class="column is-3">
        <div class="subevent-card is-secondary">
          <!-- Front side -->
          <div class="front-face animated preFadeInUp fadeInUp">
            <div class="event-date">
              <div class="date-number">18</div>
              <div class="date-meta">
                <span>monday</span>
                <span>november 2022</span>
              </div>
            </div>
            <!-- Title -->
            <div class="event-title">
              <span>Vuejs Conference</span>
              <span>Starts at 09:30AM</span>

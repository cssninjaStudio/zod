---
import Layout from '../layouts/Default.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import ElearningActivityDropdown from '../components/ElearningActivityDropdown.astro';
const title = 'E-Learning Dashboard'
---

<Layout title={title}>
  <div class="elearning-dashboard">
    <div class="columns">
      <div class="column is-8">
        <!--Dashboard header-->
        <div class="dashboard-header">
          <div class="dashboard-header-inner">
            <div class="header-content">
              <h2 class="title is-4 is-inverted is-bold is-leading">
                Welcome Back!
              </h2>
              <p class="paragraph rem-90 is-inverted-light leading-tight">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Proclivi
                currit oratio. Ita multa dicunt, quae.
              </p>
              <div class="button-wrap">
                <a class="button is-bold is-translucid">
                  <span>View All Courses</span>
                  <i class="iconify ml-2" data-icon="ph:arrow-right-bold"></i>
                </a>
              </div>
            </div>
            <div class="header-image">
              <div class="circle-shape"></div>
            </div>
          </div>
          <img src="/img/photo/clipart/sitting-girl.png" alt="Header image" />
        </div>

        <!--Popular courses-->
        <h2 class="title is-5 is-bold">Popular Courses</h2>

        <div class="popular-courses">
          <div class="columns is-multiline b-columns-half-tablet-p">
            <!--Popular course-->
            <div class="column is-6">
              <div class="popular-course is-primary">
                <div class="course-circle"></div>
                <div class="course-header">
                  <i class="iconify" data-icon="feather:monitor"></i>
                  <h4 class="title is-6">Computer Science course</h4>
                </div>
                <div class="course-body">
                  <p class="paragraph rem-90">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                    Proclivi currit oratio. Ita multa dicunt, quae vix intellegam.
                    Duo Reges: construction.
                  </p>

                  <a class="course-link">
                    <span>All courses</span>
                    <i class="iconify ml-2" data-icon="ph:arrow-right-bold"></i>
                  </a>
                </div>
              </div>
            </div>
            <!--Popular course-->
            <div class="column is-6">
              <div class="popular-course is-green">
                <div class="course-circle"></div>
                <div class="course-header">
                  <i class="iconify" data-icon="feather:box"></i>
                  <h4 class="title is-6">3D character animation</h4>
                </div>
                <div class="course-body">
                  <p class="paragraph rem-90">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                    Proclivi currit oratio. Ita multa dicunt, quae vix intellegam.
                    Duo Reges: construction.
                  </p>

                  <a class="course-link">
                    <span>All courses</span>
                    <i class="iconify ml-2" data-icon="ph:arrow-right-bold"></i>
                  </a>
                </div>
              </div>
            </div>
            <!--Popular course-->
            <div class="column is-6">
              <div class="popular-course is-purple">
                <div class="course-circle"></div>
                <div class="course-header">
                  <i class="iconify" data-icon="feather:camera"></i>
                  <h4 class="title is-6">Photography Masterclass</h4>
                </div>
                <div class="course-body">
                  <p class="paragraph rem-90">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                    Proclivi currit oratio. Ita multa dicunt, quae vix intellegam.
                    Duo Reges: construction.
                  </p>

                  <a class="course-link">
                    <span>All courses</span>
                    <i class="iconify ml-2" data-icon="ph:arrow-right-bold"></i>
                  </a>
                </div>
              </div>
            </div>
            <!--Popular course-->
            <div class="column is-6">
              <div class="popular-course is-yellow">
                <div class="course-circle"></div>
                <div class="course-header">
                  <i class="iconify" data-icon="feather:briefcase"></i>
                  <h4 class="title is-6">Marketing Discovery class</h4>
                </div>
                <div class="course-body">
                  <p class="paragraph rem-90">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                    Proclivi currit oratio. Ita multa dicunt, quae vix intellegam.
                    Duo Reges: construction.
                  </p>

                  <a class="course-link">
                    <span>All courses</span>
                    <i class="iconify ml-2" data-icon="ph:arrow-right-bold"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!--Current courses-->
        <h2 class="title is-5 is-bold">Your Courses</h2>

        <div class="current-courses">
          <div class="columns b-columns-half-mobile b-columns-third-tablet-p">
            <!--Active course-->
            <div class="column is-4">
              <div class="current-course is-blue">
                <h4>Micro-processors</h4>
                <div class="current-course-inner">
                  <div class="icon-box is-blue is-medium is-rounded">
                    <i class="iconify" data-icon="ion:hardware-chip-outline"></i>
                  </div>
                  <svg
                    class="circle-chart"
                    viewbox="0 0 33.83098862 33.83098862"
                    width="100%"
                    height="100%"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle
                      class="circle-chart-background"
                      stroke-width="2"
                      fill="none"
                      cx="16.91549431"
                      cy="16.91549431"
                      r="15.91549431"
                    />
                    <circle
                      class="circle-chart-circle"
                      stroke-width="2"
                      stroke-dasharray="42,100"
                      stroke-linecap="round"
                      fill="none"
                      cx="16.91549431"
                      cy="16.91549431"
                      r="15.91549431"
                    />
                  </svg>
                </div>
              </div>
            </div>
            <!--Active course-->
            <div class="column is-4">
              <div class="current-course is-primary">
                <h4>Photography Masterclass</h4>
                <div class="current-course-inner">
                  <div class="icon-box is-primary is-medium is-rounded">
                    <i class="iconify" data-icon="ion:monitor"></i>
                  </div>
                  <svg
                    class="circle-chart"
                    viewbox="0 0 33.83098862 33.83098862"
                    width="100%"
                    height="100%"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle
                      class="circle-chart-background"
                      stroke-width="2"
                      fill="none"
                      cx="16.91549431"
                      cy="16.91549431"
                      r="15.91549431"
                    />
                    <circle
                      class="circle-chart-circle"
                      stroke-width="2"
                      stroke-dasharray="88,100"
                      stroke-linecap="round"
                      fill="none"
                      cx="16.91549431"
                      cy="16.91549431"
                      r="15.91549431"
                    />
                  </svg>
                </div>
              </div>
            </div>
            <!--Active course-->
            <div class="column is-4">
              <div class="current-course is-primary">
                <h4>Add a New Course</h4>
                <div class="current-course-inner">
                  <svg
                    class="circle-chart"
                    viewbox="0 0 33.83098862 33.83098862"
                    width="100%"
                    height="100%"
                    xmlns="http://www.w3.org/2000/svg"
                  ></svg>
                  <div class="circle-chart-dashed"></div>
                  <a class="icon-button is-rounded raised">
                    <i class="iconify" data-icon="ion:plus"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="column is-4">
        <!--Calendar-->
        <div class="dashboard-calendar">
          <CalendarWidget />

          <div class="calendar-footer">
            <a class="icon-button is-rounded is-primary raised">
              <i class="iconify" data-icon="ion:plus"></i>
            </a>
            <span>Add reminder</span>
          </div>
        </div>

        <!--Recent activity-->
        <h2 class="title is-5 is-bold">Recent Activity</h2>

        <div class="recent-activities">
          <!--Activity item-->
          <div class="recent-activity">
            <div class="icon-box is-purple is-rounded">
              <i class="iconify" data-icon="ion:camera-outline"></i>
            </div>
            <div class="flex-meta">
              <h4 class="flex-title">Photography Masterclass</h4>
              <p class="paragraph rem-75">2 new courses · 30 mins ago</p>
            </div>
            <div class="flex-end">
              <!--dropdown-->
              <ElearningActivityDropdown />
            </div>
          </div>

          <!--Activity item-->
          <div class="recent-activity">
            <div class="icon-box is-green is-rounded">
              <i class="iconify" data-icon="ion:cube-outline"></i>
            </div>
            <div class="flex-meta">
              <h4 class="flex-title">3D character animation</h4>
              <p class="paragraph rem-75">Live starts in 2hours · 40 mins ago</p>
            </div>
            <div class="flex-end">
              <!--dropdown-->
              <ElearningActivityDropdown />
            </div>
          </div>

          <!--Activity item-->
          <div class="recent-activity">
            <div class="icon-box is-blue is-rounded">
              <i class="iconify" data-icon="ion:hardware-chip-outline"></i>
            </div>
            <div class="flex-meta">
              <h4 class="flex-title">Micro-processors</h4>
              <p class="paragraph rem-75">Finished level 2 · 5 hours ago</p>
            </div>
            <div class="flex-end">
              <!--dropdown-->
              <ElearningActivityDropdown />
            </div>
          </div>

          <!--Activity item-->
          <div class="recent-activity">
            <div class="icon-box is-primary is-rounded">
              <i class="iconify" data-icon="ion:monitor"></i>
            </div>
            <div class="flex-meta">
              <h4 class="flex-title">Computer science</h4>
              <p class="paragraph rem-75">Finished level 1 · 15 hours ago</p>
            </div>
            <div class="flex-end">
              <!--dropdown-->
              <ElearningActivityDropdown />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
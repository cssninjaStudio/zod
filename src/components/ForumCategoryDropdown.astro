<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
      'is-active': open,
      '': !open
    }`>
  <button @click="toggle()" class="dropdown-button">
    <iconify-icon class="iconify" icon="lucide:more-horizontal"></iconify-icon>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:diamonds-four-duotone"></iconify-icon>
          <div class="option-content">
            <span>Add Channel</span>
            <span>Add a child channel</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:bell-simple-duotone"></iconify-icon>
          <div class="option-content">
            <span>Subscribe</span>
            <span>Manage notifications</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:trash-duotone"></iconify-icon>
          <div class="option-content">
            <span>Delete</span>
            <span>Delete this category</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

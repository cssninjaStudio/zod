<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
    'is-active': open,
    '': !open
  }`>
  <button @click="toggle()" class="dropdown-button">
    <iconify-icon class="iconify" icon="lucide:more-horizontal"></iconify-icon>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:check-circle-duotone"></iconify-icon>
          <div class="option-content">
            <span>Resolve</span>
            <span>Resolve this ticket</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:pencil-line-duotone"></iconify-icon>
          <div class="option-content">
            <span>Edit</span>
            <span>Edit this ticket</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:lightning-duotone"></iconify-icon>
          <div class="option-content">
            <span>Escalate</span>
            <span>Escalate to next level</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:paper-plane-right-duotone"></iconify-icon>
          <div class="option-content">
            <span>Transfer</span>
            <span>Transfer this ticket</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:trash-duotone"></iconify-icon>
          <div class="option-content">
            <span>Delete</span>
            <span>Delete this ticket</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

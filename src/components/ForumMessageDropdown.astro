<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
      'is-active': open,
      '': !open
    }`>
  <button @click="toggle()" class="dropdown-button">
    <iconify-icon class="iconify" icon="lucide:more-horizontal"></iconify-icon>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a href="/content-forum-topic" class="options-item">
          <iconify-icon class="iconify" icon="ph:note-duotone"></iconify-icon>
          <div class="option-content">
            <span>Bookmark</span>
            <span>Add to bookmarks</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:pencil-duotone"></iconify-icon>
          <div class="option-content">
            <span>Edit</span>
            <span>Edit this message</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:lock-duotone"></iconify-icon>
          <div class="option-content">
            <span>Flag</span>
            <span>Flag unapropriate content</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:trash-duotone"></iconify-icon>
          <div class="option-content">
            <span>Delete</span>
            <span>Delete this message</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

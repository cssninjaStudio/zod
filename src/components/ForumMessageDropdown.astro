<div
  x-data="initDropdown()"
  @click.away="close()"
  class="dropdown-wrap is-right"
  :class="{
    'is-active': open,
    '': !open
  }"
>
  <button @click="toggle()" class="dropdown-button">
    <i class="iconify" data-icon="feather:more-horizontal"></i>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a href="/content-forum-topic" class="options-item">
            <i class="iconify" data-icon="ph:note-duotone"></i>
          <div class="option-content">
            <span>Bookmark</span>
            <span>Add to bookmarks</span>
          </div>
        </a>
        <a class="options-item">
            <i class="iconify" data-icon="ph:pencil-duotone"></i>
          <div class="option-content">
            <span>Edit</span>
            <span>Edit this message</span>
          </div>
        </a>
        <a class="options-item">
          <i class="iconify" data-icon="ph:lock-duotone"></i>
        <div class="option-content">
          <span>Flag</span>
          <span>Flag unapropriate content</span>
        </div>
      </a>
        <a class="options-item">
            <i class="iconify" data-icon="ph:trash-duotone"></i>
          <div class="option-content">
            <span>Delete</span>
            <span>Delete this message</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
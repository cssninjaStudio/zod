<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
    'is-active': open,
    '': !open
  }`>
  <button @click="toggle()" class="dropdown-button">
    <iconify-icon class="iconify" icon="lucide:more-horizontal"></iconify-icon>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:article-medium-duotone"></iconify-icon>
          <div class="option-content">
            <span>Typography</span>
            <span>Enable typography</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:check-circle-duotone"></iconify-icon>
          <div class="option-content">
            <span>Receipt</span>
            <span>Enable receipts</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:grid-four-duotone"></iconify-icon>
          <div class="option-content">
            <span>Template</span>
            <span>Use saved template</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

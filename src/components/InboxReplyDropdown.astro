<div
  x-data="initDropdown()"
  @click.away="close()"
  class="dropdown-wrap is-right"
  :class="{
    'is-active': open,
    '': !open
  }"
>
  <button @click="toggle()" class="dropdown-button">
    <i class="iconify" data-icon="feather:more-horizontal"></i>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a class="options-item">
            <i class="iconify" data-icon="ph:article-medium-duotone"></i>
          <div class="option-content">
            <span>Typography</span>
            <span>Enable typography</span>
          </div>
        </a>
        <a class="options-item">
            <i class="iconify" data-icon="ph:check-circle-duotone"></i>
          <div class="option-content">
            <span>Receipt</span>
            <span>Enable receipts</span>
          </div>
        </a>
        <a class="options-item">
            <i class="iconify" data-icon="ph:grid-four-duotone"></i>
          <div class="option-content">
            <span>Template</span>
            <span>Use saved template</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
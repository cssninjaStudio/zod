---
import InboxMessageDropdown from './InboxMessageDropdown.astro'
import InboxReplyDropdown from './InboxReplyDropdown.astro'
---

<!-- Message details -->
<div
  x-show="activeMessage === 'message-9'"
  id="message-9"
  class="inbox-message-details"
  :class="{
        'mobile-active tablet-active': isMobileMessageActive,
        '': !isMobileMessageActive
    }"
>
  <div class="header-area">
    <img class="sender-pic" src="/img/avatars/21.jpg" alt="sender photo" />
    <div class="message-meta">
      <span class="message-title">You didn't answer my last email !</span>
    </div>
    <div class="attachments is-vhidden inbox-hidden-mobile">
      <i class="iconify" data-icon="feather:paperclip"></i>
      <span>0</span>
    </div>
    <InboxMessageDropdown />
    <a
      @click="closeMobileMessage()"
      class="inbox-action inbox-close-details-mobile"
    >
      <i class="iconify" data-icon="feather:x"></i>
    </a>
  </div>
  <!--Message-->
  <div class="message-wrapper has-slimscroll">
    <div class="message-inner">
      <div class="message-head">
        <div class="info">
          <span>Sent by</span>
          <span>melodysc@gmail.com</span>
        </div>
        <div class="message-actions">
          <a class="inbox-action">
            <i class="iconify" data-icon="feather:tag"></i>
          </a>
          <a class="inbox-action">
            <i class="iconify" data-icon="feather:message-circle"></i>
          </a>
          <a class="inbox-action">
            <i class="iconify" data-icon="feather:trash-2"></i>
          </a>
        </div>
      </div>
      <!--Mail Content-->
      <div class="mail-content content">
        <p>Hi M. Miller,</p>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nos commodius
          agimus. Si longus, levis;
          <a href="#" target="_blank"
            >Summum ením bonum exposuit vacuitatem doloris;</a
          >
          Eadem fortitudinis ratio reperietur. Duo Reges: constructio interrete.
          Facile est hoc cernere in primis puerorum aetatulis.
        </p>
        <ul>
          <li>Sed residamus, inquit, si placet.</li>
          <li>
            Parvi enim primo ortu sic iacent, tamquam omnino sine animo sint.
          </li>
          <li>Beatus autem esse in maximarum rerum timore nemo potest.</li>
          <li>
            Illa argumenta propria videamus, cur omnia sint paria peccata.
          </li>
        </ul>

        <p>Melody</p>
      </div>
    </div>

    <!--Reply-->
    <div class="reply-box-wrap">
      <div class="reply-bubble">
        <div class="reply-as">
          <img src="/img/avatars/25.jpg" alt="user photo" />
          <div class="reply-details">
            <span>Reply as</span>
            <span>anthonym@gmail.com</span>
          </div>
          <InboxReplyDropdown />
        </div>
        <!--textarea-->
        <div class="control">
          <textarea
            class="textarea"
            rows="6"
            placeholder="Type your message..."
          ></textarea>
          <button type="button" class="button">Send Message</button>
        </div>
      </div>
    </div>
  </div>
</div>

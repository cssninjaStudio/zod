---
import InboxMessageDropdown from './InboxMessageDropdown.astro'
import InboxReplyDropdown from './InboxReplyDropdown.astro'
---

<!-- Message details -->
<div
  x-show="activeMessage === 'message-10'"
  id="message-10"
  class="inbox-message-details"
  :class=`{
        'mobile-active tablet-active': isMobileMessageActive,
        '': !isMobileMessageActive
    }`
>
  <div class="header-area">
    <img class="sender-pic" src="/img/avatars/19.jpg" alt="sender photo" />
    <div class="message-meta">
      <span class="message-title">Hop in for the next project review</span>
    </div>
    <div class="attachments inbox-hidden-mobile">
      <iconify-icon class="iconify" icon="lucide:paperclip"></iconify-icon>
      <span>1</span>
    </div>
    <InboxMessageDropdown />
    <a @click="closeMobileMessage()" class="inbox-action inbox-close-details-mobile">
      <iconify-icon class="iconify" icon="lucide:x"></iconify-icon>
    </a>
  </div>
  <!--Message-->
  <div class="message-wrapper has-slimscroll">
    <div class="message-inner">
      <div class="message-head">
        <div class="info">
          <span>Sent by</span>
          <span>ray@gmail.com</span>
        </div>
        <div class="message-actions">
          <a class="inbox-action">
            <iconify-icon class="iconify" icon="lucide:tag"></iconify-icon>
          </a>
          <a class="inbox-action">
            <iconify-icon class="iconify" icon="lucide:message-circle"></iconify-icon>
          </a>
          <a class="inbox-action">
            <iconify-icon class="iconify" icon="lucide:trash-2"></iconify-icon>
          </a>
        </div>
      </div>
      <!--Mail Content-->
      <div class="mail-content content">
        <p>Hi Anthony,</p>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quid adiuvas? Dat enim intervalla et relaxat. Et nemo nimium beatus est; Claudii libidini, qui tum erat summo ne imperio, dederetur.
          Duo Reges: constructio interrete.
        </p>
        <p>
          Sedulo, inquam, faciam. Certe, nisi voluptatem tanti aestimaretis.
          <a href="http://loripsum.net/" target="_blank">Recte, inquit, intellegis.</a>
          Ergo, inquit, tibi Q. Recte, inquit, intellegis.
        </p>
        <ul>
          <li>Quid nunc honeste dicit?</li>
          <li>Nos quidem Virtutes sic natae sumus, ut tibi serviremus, aliud negotii nihil habemus.</li>
          <li>Negabat igitur ullam esse artem, quae ipsa a se proficisceretur;</li>
        </ul>
        <p>
          Satis est ad hoc responsum. Quod iam a me expectare noli. Confecta res esset. Bonum integritas corporis: misera debilitas. Illum mallem levares, quo optimum atque humanissimum virum, Cn.
          Utrum igitur tibi litteram videor an totas paginas commovere?
        </p>
        <p>Ray</p>
      </div>

      <!-- Attachments -->
      <div class="attachments-list">
        <div class="attachment">
          <span>iteration-4.pdf</span>
          <div class="download-icon">
            <iconify-icon class="iconify" icon="lucide:arrow-down"></iconify-icon>
          </div>
        </div>
      </div>
    </div>

    <!--Reply-->
    <div class="reply-box-wrap">
      <div class="reply-bubble">
        <div class="reply-as">
          <img src="/img/avatars/25.jpg" alt="user photo" />
          <div class="reply-details">
            <span>Reply as</span>
            <span>anthonym@gmail.com</span>
          </div>
          <InboxReplyDropdown />
        </div>
        <!--textarea-->
        <div class="control">
          <textarea class="textarea" rows="6" placeholder="Type your message..."></textarea>
          <button type="button" class="button">Send Message</button>
        </div>
      </div>
    </div>
  </div>
</div>

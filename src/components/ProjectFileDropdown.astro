<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
    'is-active': open,
    '': !open
  }`>
  <button @click="toggle()" class="dropdown-button">
    <iconify-icon class="iconify" icon="lucide:more-horizontal"></iconify-icon>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:cloud-arrow-down-duotone"></iconify-icon>
          <div class="option-content">
            <span>Download</span>
            <span>Download this file</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:cloud-arrow-up-duotone"></iconify-icon>
          <div class="option-content">
            <span>Upload</span>
            <span>Upload new version</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:circles-three-plus-duotone"></iconify-icon>
          <div class="option-content">
            <span>Share</span>
            <span>Share with other people</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

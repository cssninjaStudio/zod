<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
      'is-active': open,
      '': !open
    }`>
  <button @click="toggle()" class="dropdown-button">
    <iconify-icon class="iconify" icon="lucide:more-horizontal"></iconify-icon>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a href="/content-crm-board" class="options-item"></a>
        <iconify-icon class="iconify" icon="ph:pencil-line-duotone"></iconify-icon>
        <div class="option-content">
          <span>Rename</span>
          <span>Rename this column</span>
        </div>
      </div>
      <a class="options-item">
        <iconify-icon class="iconify" icon="ph:lock-duotone"></iconify-icon>
        <div class="option-content">
          <span>Lock</span>
          <span>Lock this column</span>
        </div>
      </a>
      <a class="options-item">
        <iconify-icon class="iconify" icon="ph:bell-simple-duotone"></iconify-icon>
        <div class="option-content">
          <span>Subscribe</span>
          <span>Enable notifications</span>
        </div>
      </a>
      <a class="options-item">
        <iconify-icon class="iconify" icon="ph:handshake-duotone"></iconify-icon>
        <div class="option-content">
          <span>Add</span>
          <span>Create a new deal</span>
        </div>
      </a>
      <a class="options-item">
        <iconify-icon class="iconify" icon="ph:trash-duotone"></iconify-icon>
        <div class="option-content">
          <span>Delete</span>
          <span>Delete this column</span>
        </div>
      </a>
    </div>
  </div>
</div>

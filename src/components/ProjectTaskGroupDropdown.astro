<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
    'is-active': open,
    '': !open
  }`>
  <button @click="toggle()" class="dropdown-button">
    <iconify-icon class="iconify" icon="lucide:more-horizontal"></iconify-icon>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:pencil-line-duotone"></iconify-icon>
          <div class="option-content">
            <span>Edit</span>
            <span>Change group name</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:lock-simple-duotone"></iconify-icon>
          <div class="option-content">
            <span>Lock</span>
            <span>Lock this group</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:circles-three-plus-duotone"></iconify-icon>
          <div class="option-content">
            <span>New Task</span>
            <span>Add a group task</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

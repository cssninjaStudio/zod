<div
  x-data="initDropdown()"
  @click.away="close()"
  class="dropdown-wrap is-right"
  :class="{
    'is-active': open,
    '': !open
  }"
>
  <button @click="toggle()" class="dropdown-button">
    <i class="iconify" data-icon="feather:more-horizontal"></i>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a class="options-item">
          <i class="iconify" data-icon="ph:chat-circle-dots-duotone"></i>
          <div class="option-content">
            <span>Message</span>
            <span>Send a message</span>
          </div>
        </a>
        <a class="options-item">
          <i class="iconify" data-icon="ph:user-circle-duotone"></i>
          <div class="option-content">
            <span>Profile</span>
            <span>View profile details</span>
          </div>
        </a>
        <a class="options-item">
          <i class="iconify" data-icon="ph:ticket-duotone"></i>
          <div class="option-content">
            <span>Tickets</span>
            <span>View assigned tickets</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

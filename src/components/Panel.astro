---
import Calendar from './Calendar.astro'
---

<div class="panel" :class=`{
    'is-active': $store.app.isPanelOpened,
    '': !$store.app.isPanelOpened
  }`>
  <div class="panel-header">
    <h2 class="title is-narrow">My Schedule</h2>
    <button class="close-button mask mask-blob" @click="$store.app.isPanelOpened = false">
      <iconify-icon class="iconify" icon="lucide:arrow-right"></iconify-icon>
    </button>
  </div>
  <div class="panel-calendar">
    <Calendar />
    <div class="calendar-button">
      <button class="button is-fullwidth">
        <iconify-icon class="iconify" icon="ion:calendar-outline"></iconify-icon>
        <span>Manage Schedule</span>
      </button>
    </div>
  </div>
  <div class="panel-conversations-header">
    <h2 class="title is-narrow">My Team</h2>
  </div>
  <div class="panel-conversations-body has-slimscroll">
    <!--Team Member-->
    <a class="panel-conversation">
      <img class="avatar is-xxs is-reset mask mask-blob" src="/img/avatars/42.jpg" alt="" />
      <div class="meta">
        <span>Helen Miller</span>
        <span>Software Engineer</span>
      </div>
      <button class="mask mask-blob">
        <iconify-icon class="iconify" icon="lucide:arrow-right"></iconify-icon>
      </button>
    </a>
    <!--Team Member-->

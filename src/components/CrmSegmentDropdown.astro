<div
  x-data="initDropdown()"
  @click.away="close()"
  class="dropdown-wrap is-right"
  :class="{
    'is-active': open,
    '': !open
  }"
>
  <button @click="toggle()" class="dropdown-button">
    <i class="iconify" data-icon="feather:more-horizontal"></i>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a href="/content-crm-board" class="options-item">
            <i class="iconify" data-icon="ph:projector-screen-duotone"></i>
          <div class="option-content">
            <span>Open Board</span>
            <span>Open this kanban board</span>
          </div>
        </a>
        <a class="options-item">
            <i class="iconify" data-icon="ph:pencil-line-duotone"></i>
          <div class="option-content">
            <span>Edit Board</span>
            <span>Edit board details</span>
          </div>
        </a>
        <a class="options-item">
            <i class="iconify" data-icon="ph:bell-simple-duotone"></i>
          <div class="option-content">
            <span>Notifications</span>
            <span>Manage notifications</span>
          </div>
        </a>
        <a class="options-item">
          <i class="iconify" data-icon="ph:trash-duotone"></i>
        <div class="option-content">
          <span>Delete</span>
          <span>Delete this board</span>
        </div>
      </a>
      </div>
    </div>
  </div>
</div>
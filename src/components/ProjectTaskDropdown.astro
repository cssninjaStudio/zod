<div
  x-data="initDropdown()"
  @click.away="close()"
  class="dropdown-wrap is-right"
  :class="{
    'is-active': open,
    '': !open
  }"
>
  <button @click="toggle()" class="dropdown-button">
    <i class="iconify" data-icon="feather:more-horizontal"></i>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a class="options-item">
            <i class="iconify" data-icon="ph:briefcase-duotone"></i>
          <div class="option-content">
            <span>View</span>
            <span>View task details</span>
          </div>
        </a>
        <a class="options-item">
            <i class="iconify" data-icon="ph:pencil-line-duotone"></i>
          <div class="option-content">
            <span>Edit</span>
            <span>Edit task details</span>
          </div>
        </a>
        <a class="options-item">
            <i class="iconify" data-icon="ph:users-four-duotone"></i>
          <div class="option-content">
            <span>Invite</span>
            <span>Invite collaborators</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
---
import InboxMessageDropdown from './InboxMessageDropdown.astro'
import InboxReplyDropdown from './InboxReplyDropdown.astro'
---

<!-- Message details -->
<div x-show="activeMessage === 'message-1'" id="message-1" class="inbox-message-details" :class=`{
        'mobile-active tablet-active': isMobileMessageActive,
        '': !isMobileMessageActive
    }`>
  <div class="header-area">
    <img class="sender-pic" src="/img/avatars/16.jpg" alt="sender photo" />
    <div class="message-meta">
      <span class="message-title">Important project review next thursday</span>
    </div>
    <div class="attachments inbox-hidden-mobile">
      <iconify-icon class="iconify" icon="lucide:paperclip"></iconify-icon>
      <span>2</span>
    </div>
    <InboxMessageDropdown />
    <a @click="closeMobileMessage()" class="inbox-action inbox-close-details-mobile">
      <iconify-icon class="iconify" icon="lucide:x"></iconify-icon>
    </a>
  </div>
  <!--Message-->
  <div class="message-wrapper has-slimscroll">
    <div class="message-inner">
      <div class="message-head">
        <div class="info">
          <span>Sent by</span>
          <span>robert@gmail.com</span>
        </div>
        <div class="message-actions">
          <a class="inbox-action">
            <iconify-icon class="iconify" icon="lucide:tag"></iconify-icon>
          </a>
          <a class="inbox-action">
            <iconify-icon class="iconify" icon="lucide:message-circle"></iconify-icon>
          </a>
          <a class="inbox-action">
            <iconify-icon class="iconify" icon="lucide:trash-2"></iconify-icon>
          </a>
        </div>
      </div>
      <!--Mail Content-->
      <div class="mail-content content">
        <p>Hey Anthony,</p>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Haec igitur Epicuri non probo, inquam. Nihil sane. <b>Efficiens dici potest.</b>
          <i>Urgent tamen et nihil remittunt.</i> Ea possunt paria non esse. Duo Reges: constructio interrete.
        </p>
        <ul>
          <li>Ab his oratores, ab his imperatores ac rerum publicarum principes extiterunt.</li>
          <li>Eiuro, inquit adridens, iniquum, hac quidem de re;</li>
        </ul>
        <p>Tum Triarius: Posthac quidem, inquit, audacius. Quodsi ipsam honestatem undique pertectam atque absolutam. Comprehensum, quod cognitum non habet?</p>
        <p>
          <i>Nonne igitur tibi videntur, inquit, mala?</i> Poterat autem inpune; Nunc omni virtuti vitium contrario nomine opponitur.
        </p>
        <p>Sincerely,</p>
        <p>Robert Filburr - Cofounder</p>
      </div>

      <!-- Attachments -->
      <div class="attachments-list">
        <div class="attachment">
          <span>budget_draft.xlsx</span>
          <div class="download-icon">
            <iconify-icon class="iconify" icon="lucide:arrow-down"></iconify-icon>
          </div>
        </div>
        <div class="attachment">
          <span>project-notes.docx</span>
          <div class="download-icon">
            <iconify-icon class="iconify" icon="lucide:arrow-down"></iconify-icon>
          </div>
        </div>
      </div>
    </div>

    <!--Reply-->
    <div class="reply-box-wrap">
      <div class="reply-bubble">
        <div class="reply-as">
          <img src="/img/avatars/25.jpg" alt="user photo" />
          <div class="reply-details">
            <span>Reply as</span>
            <span>anthonym@gmail.com</span>
          </div>
          <InboxReplyDropdown />
        </div>
        <!--textarea-->
        <div class="control">
          <textarea class="textarea" rows="6" placeholder="Type your message..."></textarea>
          <button type="button" class="button">Send Message</button>
        </div>
      </div>
    </div>
  </div>
</div>

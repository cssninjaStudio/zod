<div x-data="initDropdown()" @click.away="close()" class="dropdown-wrap is-right" :class=`{
      'is-active': open,
      '': !open
    }`>
  <button @click="toggle()" class="dropdown-button">
    <iconify-icon class="iconify" icon="lucide:more-horizontal"></iconify-icon>
  </button>
  <div class="drop-menu">
    <div class="menu-inner">
      <div class="menu-header">
        <h3>Actions</h3>
      </div>
      <div class="options-items">
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:chart-pie-slice-duotone"></iconify-icon>
          <div class="option-content">
            <span>Monitor</span>
            <span>See detailed stats</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:gear-six-duotone"></iconify-icon>
          <div class="option-content">
            <span>Manage</span>
            <span>Manage server configuration</span>
          </div>
        </a>
        <a class="options-item">
          <iconify-icon class="iconify" icon="ph:hand-duotone"></iconify-icon>
          <div class="option-content">
            <span>Pause</span>
            <span>Pause server temporarily</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
